# Copy to .env before running anything: cp .env.example .env
# Every host port lives here so the lab can be moved out of the way of whatever
# else is already running on your machine.

# --- Image versions ----------------------------------------------------------
WEAVER_VERSION=v0.25.1
BDOT_VERSION=1.105.1
BINDPLANE_VERSION=1.89.5
JAEGER_VERSION=1.65.0
PROMETHEUS_VERSION=v3.1.0
LOKI_VERSION=3.3.2
GRAFANA_VERSION=11.5.1

# --- Application ports -------------------------------------------------------
GATEWAY_PORT=8000
CHECKOUT_PORT=8001
PAYMENT_PORT=8002

# --- Collector ports ---------------------------------------------------------
# The gateway service's agent also accepts OTLP from the host, which is how
# `make emit` injects registry-generated sample signals into the pipeline.
GATEWAY_AGENT_OTLP_GRPC_PORT=4317
GW_COLLECTOR_ZPAGES_PORT=55679
GW_COLLECTOR_HEALTH_PORT=13133

# --- Weaver live-check -------------------------------------------------------
WEAVER_ADMIN_PORT=4320

# --- Backends ----------------------------------------------------------------
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Demo behaviour ----------------------------------------------------------
# When true, the payment service deliberately emits telemetry that violates the
# registry (an undeclared attribute holding a fake card number, and an invalid
# enum value). Set to false to watch the live-check report go clean.
EMIT_VIOLATIONS=true
# Seconds between synthetic orders from the load generator.
LOADGEN_INTERVAL_SECONDS=2

# --- Optional: self-hosted Bindplane server (docker compose --profile bindplane)
# The server boots without this, but stops working once you create an organization.
# Request a free-tier key at https://bindplane.com/download (it arrives by e-mail).
BINDPLANE_LICENSE=
BINDPLANE_UI_PORT=3001
BINDPLANE_USERNAME=admin
BINDPLANE_PASSWORD=admin
BINDPLANE_SESSION_SECRET=8a3d1f6e-2c47-4b91-9f0a-5d6e7c8b9a01
BINDPLANE_POSTGRES_PASSWORD=password
# Project secret key, shown in the Bindplane UI under Agents -> Install Agent.
# The agent-managed collector uses it to register over OpAMP.
BINDPLANE_SECRET_KEY=
